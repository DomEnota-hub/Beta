      "nodes": [
        {
          "id": "s1",
          "type": "QUESTION",
          "text": "По ранее зафиксированным данным дизель проворачивался при штатном пуске?",
          "responses": {
            "YES": "s2",
            "NO": "s3",
            "UNKNOWN": "stop"
          },
          "sourceRefs": [
            "DOC",
            "N61"
          ],
          "permittedAction": false
        },
        {
          "id": "s2",
          "type": "QUESTION",
          "text": "При провороте отмечались признаки воспламенения?",
          "responses": {
            "YES": "s6",
            "NO": "s7",
            "UNKNOWN": "stop"
          },
          "sourceRefs": [
            "DOC",
            "N38"
          ],
          "permittedAction": false
        },
        {
          "id": "s3",
          "type": "QUESTION",
          "text": "В старой записи есть штатная индикация разрешения пуска?",
          "responses": {
            "YES": "s4",
            "NO": "s5",
            "UNKNOWN": "stop"
          },
          "sourceRefs": [
            "DOC",
            "N68"
          ],
          "permittedAction": false
        },
        {
          "id": "s4",
          "type": "OBSERVATION_REPORT",
          "text": "Нет проворота при отмеченном разрешении: историческая гипотеза пускового привода, не диагноз.",
          "responses": {},
          "sourceRefs": [
            "DOC",
            "N61"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "s5",
          "type": "OBSERVATION_REPORT",
          "text": "Отсутствие разрешения: возможна ветвь цепей управления. Никаких обходов блокировок.",
          "responses": {},
          "sourceRefs": [
            "DOC",
            "N68"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "s6",
          "type": "OBSERVATION_REPORT",
          "text": "Воспламенение отмечалось: отделить от отказа полного пуска и сценария самопроизвольной остановки.",
          "responses": {},
          "sourceRefs": [
            "DOC",
            "N38"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "s7",
          "type": "OBSERVATION_REPORT",
          "text": "Проворот без воспламенения не доказывает дефект топливоподачи; остаются альтернативы.",
          "responses": {},
          "sourceRefs": [
            "DOC",
            "N15"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "stop",
          "type": "STOP",
          "text": "STOP: наблюдений недостаточно или профиль не подтверждён. Не повторять пуск и не вмешиваться в оборудование ради проверки.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        }
      ]
    },
