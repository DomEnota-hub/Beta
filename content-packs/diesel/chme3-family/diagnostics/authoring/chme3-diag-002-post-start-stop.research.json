          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "d9",
          "type": "QUESTION",
          "text": "Есть ранее зарегистрированное отклонение давления масла или предупреждение по смазке?",
          "responses": {
            "YES": "d10",
            "NO": "d11",
            "UNKNOWN": "stop"
          },
          "sourceRefs": [
