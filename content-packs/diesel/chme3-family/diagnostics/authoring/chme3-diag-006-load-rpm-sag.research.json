    "SHORT": {
      "startNodeId": "s1",
      "nodes": [
        {
          "id": "s1",
          "type": "QUESTION",
          "text": "Из старой записи следует отсутствие активной аварии и опасного роста оборотов?",
          "responses": {
            "YES": "s2",
            "NO": "stop-safety",
            "UNKNOWN": "stop-safety"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "s2",
          "type": "QUESTION",
          "text": "Ранее зафиксирована просадка именно под нагрузкой?",
          "responses": {
            "YES": "s3",
            "NO": "obs-other",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "s3",
          "type": "QUESTION",
          "text": "Одновременно отмечен густой чёрный выхлоп?",
          "responses": {
            "YES": "obs-air",
            "NO": "obs-fuel",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "DOC",
            "N49"
          ],
          "permittedAction": false
        },
        {
          "id": "obs-air",
          "type": "OBSERVATION_REPORT",
          "text": "Воздушная ветвь или перегрузка возможны; неисправность турбины не доказана.",
          "responses": {},
          "sourceRefs": [
            "DOC",
            "N49"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "obs-fuel",
          "type": "OBSERVATION_REPORT",
          "text": "Без дымности сохраняются топливная, регуляторная и нагрузочная гипотезы.",
          "responses": {},
          "sourceRefs": [
            "DOC",
            "N30",
            "N38"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "obs-other",
          "type": "OBSERVATION_REPORT",
          "text": "Симптом 006 не подтверждён; не смешивать с отказом набора по позициям.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "stop-safety",
          "type": "STOP",
          "text": "STOP: активная авария или опасный режим не исключены. Новые пуски, испытания и вмешательства запрещены; действующий аварийный порядок и полномочия требуют отдельного подтверждения.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "stop-unknown",
          "type": "STOP",
          "text": "STOP: достоверных исходных сведений недостаточно. Не воспроизводить нагрузку, не вскрывать оборудование и не выполнять регулировку.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        }
      ]
    },
