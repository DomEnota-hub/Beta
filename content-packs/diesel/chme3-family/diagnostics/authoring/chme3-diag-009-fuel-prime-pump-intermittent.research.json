      "startNodeId": "s1",
      "nodes": [
        {
          "id": "s1",
          "type": "QUESTION",
          "text": "По архиву исключены активная утечка топлива, пожар, остановка по защите и другая опасность?",
          "responses": {
            "YES": "s2",
            "NO": "stop-safety",
            "UNKNOWN": "stop-safety"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "s2",
          "type": "QUESTION",
          "text": "Есть ранее записанный симптом отсутствия подачи или перебоев именно топливоподкачки?",
          "responses": {
            "YES": "s3",
            "NO": "obs-other",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "s3",
          "type": "QUESTION",
          "text": "Подтверждён по документации установленный тип привода насоса?",
          "responses": {
            "YES": "obs-identified",
            "NO": "obs-unverified",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "DOC",
            "N34"
          ],
          "permittedAction": false
        },
        {
          "id": "obs-identified",
          "type": "OBSERVATION_REPORT",
          "text": "Тип привода указан в архиве; сравнение с историческим §34 допустимо только как информация, не как разрешение действий.",
          "responses": {},
          "sourceRefs": [
            "DOC",
            "N34"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "obs-unverified",
          "type": "OBSERVATION_REPORT",
          "text": "Тип привода не подтверждён; электрическую неисправность нельзя объявлять причиной, поскольку исторический насос механический.",
          "responses": {},
          "sourceRefs": [
            "N34",
            "R996"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "obs-other",
          "type": "OBSERVATION_REPORT",
          "text": "Исходный симптом подкачки не подтверждён; отделить от отказа пуска, остановки дизеля и просадки под нагрузкой.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "stop-safety",
          "type": "STOP",
          "text": "STOP: активное или не исключённое нарушение смазки/топливоподачи либо другая опасность. Не воспроизводить неисправность, не запускать и не нагружать дизель. Действующий аварийный порядок и полномочия требуют отдельного подтверждения.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "stop-unknown",
          "type": "STOP",
          "text": "STOP: данных или подтверждения исполнения недостаточно. Не проводить новых испытаний, измерений, вскрытий и регулировок.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        }
      ]
    },
