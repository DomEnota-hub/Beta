  "versions": {
    "SHORT": {
      "startNodeId": "s1",
      "nodes": [
        {
          "id": "s1",
          "type": "QUESTION",
          "text": "По ранее зафиксированным сведениям исключены активное разжижение масла, падение давления и другая опасность?",
          "responses": {
            "YES": "s2",
            "NO": "stop-safety",
            "UNKNOWN": "stop-safety"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "s2",
          "type": "QUESTION",
          "text": "В архиве есть именно признак топлива в масле или роста уровня, а не только нарушение давления?",
          "responses": {
            "YES": "s3",
            "NO": "obs-other",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "s3",
          "type": "QUESTION",
          "text": "Рост уровня сопровождается уже документированным запахом топлива либо изменением свойств масла?",
          "responses": {
            "YES": "obs-fuel",
            "NO": "obs-measure",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "N104"
          ],
          "permittedAction": false
        },
        {
          "id": "obs-fuel",
          "type": "OBSERVATION_REPORT",
          "text": "Совпадение архивных признаков усиливает подозрение на попадание топлива; путь через аппаратуру или цилиндры не доказан.",
          "responses": {},
          "sourceRefs": [
            "N104"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "obs-measure",
          "type": "OBSERVATION_REPORT",
          "text": "Рост уровня без других сведений не подтверждает попадание топлива; условия старого измерения остаются неизвестны.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "obs-other",
          "type": "OBSERVATION_REPORT",
          "text": "Симптом 010 не подтверждён. Низкое давление смазки и перебои подачи топлива относятся к отдельным сценариям.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "stop-safety",
          "type": "STOP",
          "text": "STOP: признаки разжижения масла, падения давления либо их отсутствие не исключены. Не запускать, не нагружать, не отбирать пробы; решение только по подтверждённому РЭ.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "stop-unknown",
          "type": "STOP",
          "text": "STOP: данных о признаках или исполнении недостаточно. Не проводить новых измерений и вскрытий.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        }
      ]
    },
    "DETAILED": {
      "startNodeId": "d1",
      "nodes": [
        {
          "id": "d1",
          "type": "QUESTION",
          "text": "По архиву исключены активное разжижение масла, опасное падение давления и другие угрозы?",
