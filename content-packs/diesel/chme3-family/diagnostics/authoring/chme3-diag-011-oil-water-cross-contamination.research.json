  "versions": {
    "SHORT": {
      "startNodeId": "s1",
      "nodes": [
        {
          "id": "s1",
          "type": "QUESTION",
          "text": "По архивным сведениям исключены активное смешение сред, потеря охлаждения/смазки и другая опасность?",
          "responses": {
            "YES": "s2",
            "NO": "stop-safety",
            "UNKNOWN": "stop-safety"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "s2",
          "type": "QUESTION",
          "text": "Зафиксировано именно смешение масла и охлаждающей жидкости?",
          "responses": {
            "YES": "s3",
            "NO": "obs-other",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "s3",
          "type": "QUESTION",
          "text": "Архивный признак указывает на воду/эмульсию в масле, а не масло в воде?",
          "responses": {
            "YES": "obs-water-in-oil",
            "NO": "obs-oil-in-water",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "N104"
          ],
          "permittedAction": false
        },
        {
          "id": "obs-water-in-oil",
          "type": "OBSERVATION_REPORT",
          "text": "Эмульсия в масле описывает одно направление загрязнения; теплообменник и внутренние утечки остаются разными версиями.",
          "responses": {},
          "sourceRefs": [
            "N104"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "obs-oil-in-water",
          "type": "OBSERVATION_REPORT",
          "text": "Масляные следы в охлаждении не равны эмульсии в картере; направление и причина ещё не доказаны.",
          "responses": {},
          "sourceRefs": [
            "N46"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "obs-other",
          "type": "OBSERVATION_REPORT",
          "text": "Нет подтверждённого смешения. Перегрев воды и топливо в масле имеют отдельные ID.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "stop-safety",
          "type": "STOP",
          "text": "STOP: активное/не исключённое смешение сред либо опасная потеря охлаждения/смазки. Не запускать, не нагружать, не открывать горячую систему.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "stop-unknown",
          "type": "STOP",
          "text": "STOP: направление загрязнения или профиль неизвестны; новые проверки не предлагать.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        }
      ]
    },
    "DETAILED": {
      "startNodeId": "d1",
      "nodes": [
        {
          "id": "d1",
          "type": "QUESTION",
          "text": "По сохранённым данным исключены опасная потеря смазки/охлаждения и активное смешение?",
          "responses": {
            "YES": "d2",
            "NO": "stop-safety",
            "UNKNOWN": "stop-safety"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "d2",
          "type": "QUESTION",
          "text": "Есть архивное свидетельство загрязнения масла или охлаждающей жидкости?",
          "responses": {
            "YES": "d3",
            "NO": "obs-other",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "d3",
          "type": "QUESTION",
          "text": "В архиве отмечена эмульсия/вода именно в картерном масле?",
          "responses": {
            "YES": "d4",
            "NO": "d5",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "N104"
          ],
          "permittedAction": false
        },
        {
          "id": "d4",
          "type": "QUESTION",
          "text": "Одновременно есть архивные следы масла в охлаждающей жидкости?",
          "responses": {
            "YES": "obs-both",
            "NO": "obs-water-in-oil",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "d5",
          "type": "QUESTION",
          "text": "В архиве отмечено масло в охлаждении и связь с водомасляным теплообменником?",
          "responses": {
            "YES": "obs-hex",
            "NO": "obs-oil-in-water",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "N46"
          ],
          "permittedAction": false
        },
        {
          "id": "obs-water-in-oil",
          "type": "OBSERVATION_REPORT",
          "text": "Вода в масле исторически отмечена как опасная для смазки; не устанавливает место утечки.",
          "responses": {},
          "sourceRefs": [
            "N104"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "obs-oil-in-water",
          "type": "OBSERVATION_REPORT",
          "text": "Масло в охлаждающей жидкости не доказывает неисправность теплообменника.",
          "responses": {},
          "sourceRefs": [
            "N47"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "obs-both",
          "type": "OBSERVATION_REPORT",
          "text": "Оба направления загрязнения зафиксированы; перепад давлений и место сообщения контуров неизвестны.",
          "responses": {},
          "sourceRefs": [
            "N46"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "obs-hex",
          "type": "OBSERVATION_REPORT",
          "text": "Теплообменник связывает водяной и масляный контуры конструктивно, но его дефект без проверки не подтверждён.",
          "responses": {},
          "sourceRefs": [
            "N46"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "obs-other",
          "type": "OBSERVATION_REPORT",
          "text": "Симптом 011 не подтверждён. Не объединять с топливом в масле и перегревом.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "stop-safety",
          "type": "STOP",
          "text": "STOP: активное/не исключённое смешение, потеря смазки или охлаждения. Не открывать горячий контур, не запускать и не нагружать.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "stop-unknown",
          "type": "STOP",
          "text": "STOP: недостаточно исторических сведений или подтверждённого профиля.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        }
      ]
    }
  },
