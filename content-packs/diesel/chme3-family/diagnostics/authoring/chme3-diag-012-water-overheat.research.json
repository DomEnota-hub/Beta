          "permittedAction": false
        },
        {
          "id": "s2",
          "type": "QUESTION",
          "text": "В архиве отмечен рост температуры воды?",
          "responses": {
            "YES": "s3",
            "NO": "obs-other",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "s3",
          "type": "QUESTION",
          "text": "В архиве отдельно отмечены вентилятор или жалюзи?",
          "responses": {
            "YES": "obs-air",
            "NO": "obs-water",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "N56"
          ],
          "permittedAction": false
        },
        {
          "id": "obs-air",
          "type": "OBSERVATION_REPORT",
          "text": "Вентилятор и жалюзи отдельные гипотезы, причина неизвестна.",
