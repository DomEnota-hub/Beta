          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "obs-water",
          "type": "OBSERVATION_REPORT",
          "text": "Циркуляция основного и вспомогательного контуров и индикация требуют отдельной оценки; насос не признан неисправным.",
          "responses": {},
          "sourceRefs": [
            "N47"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "obs-other",
          "type": "OBSERVATION_REPORT",
          "text": "Перегрев не подтверждён; не смешивать с загрязнением масла и просадкой оборотов.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "stop-safety",
          "type": "STOP",
          "text": "STOP: продолжающийся/не исключённый перегрев. Не запускать, не нагружать, не открывать горячий контур, не трогать жалюзи или вращающийся вентилятор.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "stop-unknown",
          "type": "STOP",
          "text": "STOP: данных, профиля, схемы или подтверждённого источника нет; никаких новых операций.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        }
      ]
    },
