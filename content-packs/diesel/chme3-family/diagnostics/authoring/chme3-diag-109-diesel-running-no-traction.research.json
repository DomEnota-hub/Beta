  "versions": {
    "SHORT": {
      "startNodeId": "s1",
      "nodes": [
        {
          "id": "s1",
          "type": "QUESTION",
          "text": "По уже имеющимся сведениям исключены опасные признаки электрической части, движение или продолжающаяся нештатная тяга?",
          "responses": {
            "YES": "s2",
            "NO": "stop-safety",
            "UNKNOWN": "stop-safety"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "s2",
          "type": "QUESTION",
          "text": "Подтверждено, что дизель работал, но тяга отсутствовала, а не наблюдалась другая неисправность?",
          "responses": {
            "YES": "s3",
            "NO": "obs-a",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "s3",
          "type": "QUESTION",
          "text": "В ранее сохранённых штатных показаниях отдельно указано состояние поездных контакторов и реверсора?",
          "responses": {
            "YES": "obs-b",
            "NO": "obs-c",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "obs-a",
          "type": "OBSERVATION_REPORT",
          "text": "Отсутствие работы дизеля либо иной симптом не доказывает неисправность тяговой передачи; требуется отдельная исходная карточка.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "obs-b",
          "type": "OBSERVATION_REPORT",
          "text": "Показания помогают разделить направление/контакторы и возбуждение, но не доказывают неисправность конкретного аппарата.",
          "responses": {},
          "sourceRefs": [
            "N74"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "obs-c",
          "type": "OBSERVATION_REPORT",
          "text": "Без подтверждённых показаний нельзя утверждать отказ реверсора, контакторов или тягового генератора.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "stop-safety",
          "type": "STOP",
          "text": "STOP: опасное состояние либо его отсутствие не подтверждено. Не выполнять новых включений, движения, измерений или вмешательств; действовать по действующим инструкциям и полномочиям.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "stop-unknown",
          "type": "STOP",
          "text": "STOP: сведения, точная схема или профиль неизвестны. UNKNOWN/BLOCKED, причина не установлена, действия не разрешены.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        }
      ]
    },
    "DETAILED": {
      "startNodeId": "d1",
      "nodes": [
        {
          "id": "d1",
          "type": "QUESTION",
          "text": "По документированному эпизоду исключены опасные признаки и продолжающееся нештатное движение?",
          "responses": {
            "YES": "d2",
            "NO": "stop-safety",
            "UNKNOWN": "stop-safety"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "d2",
          "type": "QUESTION",
          "text": "Есть запись о работающем дизеле при отсутствии тяги?",
          "responses": {
            "YES": "d3",
            "NO": "obs-a",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "d3",
          "type": "QUESTION",
          "text": "В журнале зафиксированы выбранное направление и штатный признак положения реверсора?",
          "responses": {
            "YES": "d4",
            "NO": "obs-b",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "d4",
          "type": "QUESTION",
          "text": "Состояние поездных контакторов известно по ранее сохранённой записи, без новых проверок под напряжением?",
          "responses": {
            "YES": "d5",
            "NO": "obs-c",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "d5",
          "type": "QUESTION",
          "text": "Есть штатная запись о нагрузке генератора, отличающая отсутствие возбуждения от отсутствия тяги при наличии нагрузки?",
          "responses": {
            "YES": "obs-d",
            "NO": "obs-e",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "obs-a",
          "type": "OBSERVATION_REPORT",
          "text": "Если дизель не работал, сценарий 109 неприменим; без независимого симптома причина UNKNOWN/BLOCKED.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "obs-b",
          "type": "OBSERVATION_REPORT",
          "text": "Отсутствие сведений о положении реверсора не доказывает его отказ.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "obs-c",
          "type": "OBSERVATION_REPORT",
          "text": "Без штатных записей по контакторам нельзя переходить к выводам о возбуждении или силовой цепи.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "obs-d",
          "type": "OBSERVATION_REPORT",
          "text": "Даже при известных штатных показаниях различия схем ЧМЭ3, ЧМЭ3Т и ЧМЭ3Э остаются открытыми до сверки профиля.",
          "responses": {},
          "sourceRefs": [
            "N67"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "obs-e",
          "type": "OBSERVATION_REPORT",
          "text": "Нет достоверной записи о генераторе: предположения о возбудителе и ТЭД остаются гипотезами.",
          "responses": {},
          "sourceRefs": [
            "N74"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "stop-safety",
          "type": "STOP",
          "text": "STOP: опасное состояние либо его отсутствие не подтверждено. Не выполнять новых включений, движения, измерений или вмешательств; действовать по действующим инструкциям и полномочиям.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "stop-unknown",
          "type": "STOP",
          "text": "STOP: сведения, точная схема или профиль неизвестны. UNKNOWN/BLOCKED, причина не установлена, действия не разрешены.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        }
      ]
    }
  },
