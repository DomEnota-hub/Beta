            "YES": "obs-b",
            "NO": "stop-specific",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "obs-a",
          "type": "OBSERVATION_REPORT",
          "text": "Внезапное торможение без команды не подтверждено; не приписывать событие ЭПК.",
