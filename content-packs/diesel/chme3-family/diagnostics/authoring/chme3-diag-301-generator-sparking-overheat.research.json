    "SHORT": {
      "startNodeId": "s1",
      "nodes": [
        {
          "id": "s1",
          "type": "QUESTION",
          "text": "По сохранённым данным эпизод завершён и нет продолжающегося опасного искрения, дыма или перегрева?",
          "responses": {
            "YES": "s2",
            "NO": "stop-safety",
            "UNKNOWN": "stop-safety"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "s2",
          "type": "QUESTION",
          "text": "По ранее зафиксированным признакам источник симптома именно тяговый генератор, а не ТЭД?",
          "responses": {
            "YES": "s3",
            "NO": "obs-a",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "s3",
          "type": "QUESTION",
          "text": "По штатной записи симптом связан с тяговой нагрузкой?",
          "responses": {
            "YES": "obs-b",
            "NO": "obs-c",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "obs-a",
          "type": "OBSERVATION_REPORT",
          "text": "Не доказано, что источник симптома генератор: не смешивать с ТЭД CHME3-DIAG-302.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "obs-b",
          "type": "OBSERVATION_REPORT",
          "text": "Зависимость от нагрузки допускает разные объяснения: охлаждение, возбуждение, коммутация.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "obs-c",
          "type": "OBSERVATION_REPORT",
          "text": "Наличие симптома вне тяговой нагрузки не доказывает внутренний дефект генератора.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "stop-safety",
          "type": "STOP",
          "text": "STOP: безопасность не подтверждена. Не возобновлять нагрузку, не повторять включения, не вскрывать аппараты, не обходить защиты.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "stop-unknown",
          "type": "STOP",
          "text": "STOP: источник, профиль или прежние наблюдения неизвестны; причина не установлена, никаких действий.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        }
      ]
    },
