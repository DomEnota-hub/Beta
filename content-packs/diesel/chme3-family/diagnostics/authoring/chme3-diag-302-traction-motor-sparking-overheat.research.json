  "versions": {
    "SHORT": {
      "startNodeId": "s1",
      "nodes": [
        {
          "id": "s1",
          "type": "QUESTION",
          "text": "По сохранённым данным опасный перегрев/искрение прекратились, эпизод завершён?",
          "responses": {
            "YES": "s2",
            "NO": "stop-safety",
            "UNKNOWN": "stop-safety"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "s2",
          "type": "QUESTION",
          "text": "По записям затронут один определённый ТЭД, а не несколько двигателей?",
          "responses": {
            "YES": "s3",
            "NO": "obs-a",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "s3",
          "type": "QUESTION",
          "text": "В ранее составленном акте отмечено отклонение охлаждения соответствующей тележки?",
          "responses": {
            "YES": "obs-b",
            "NO": "obs-c",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "obs-a",
          "type": "OBSERVATION_REPORT",
          "text": "При нескольких ТЭД возможна общая причина охлаждения/нагрузки, а не несколько независимых отказов.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "obs-b",
          "type": "OBSERVATION_REPORT",
          "text": "Вентилятор тележки по архивной схеме является отдельной гипотезой; ремонт и переключения запрещены.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "obs-c",
          "type": "OBSERVATION_REPORT",
          "text": "При сохранном по записям охлаждении причина не локализована; щётки и коллектор не признаны дефектными.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "stop-safety",
          "type": "STOP",
          "text": "STOP: безопасность не подтверждена. Не возобновлять нагрузку, не повторять включения, не вскрывать аппараты, не обходить защиты.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "stop-unknown",
          "type": "STOP",
          "text": "STOP: источник, профиль или прежние наблюдения неизвестны; причина не установлена, никаких действий.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        }
      ]
    },
