  "versions": {
    "SHORT": {
      "startNodeId": "s1",
      "nodes": [
        {
          "id": "s1",
          "type": "QUESTION",
          "text": "По документированной истории защита сейчас не находится в повторяющемся аварийном состоянии?",
          "responses": {
            "YES": "s2",
            "NO": "stop-safety",
            "UNKNOWN": "stop-safety"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "s2",
          "type": "QUESTION",
          "text": "Из штатной записи установлен конкретный защитный аппарат и защищаемая цепь?",
          "responses": {
            "YES": "s3",
            "NO": "obs-a",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "s3",
          "type": "QUESTION",
          "text": "Срабатывание повторялось в том же документированном режиме без новых проверок?",
          "responses": {
            "YES": "obs-b",
            "NO": "obs-c",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "obs-a",
          "type": "OBSERVATION_REPORT",
          "text": "«Выбило защиту» без аппарата и цепи не позволяет выбирать схему или способ восстановления.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "obs-b",
          "type": "OBSERVATION_REPORT",
          "text": "Повторное срабатывание не является поводом для новых попыток; нужен безопасный анализ существующей истории.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "obs-c",
          "type": "OBSERVATION_REPORT",
          "text": "Однократное срабатывание тоже не доказывает исправность защищаемой цепи.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "stop-safety",
          "type": "STOP",
          "text": "STOP: безопасность не подтверждена. Не возобновлять нагрузку, не повторять включения, не вскрывать аппараты, не обходить защиты.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "stop-unknown",
          "type": "STOP",
          "text": "STOP: источник, профиль или прежние наблюдения неизвестны; причина не установлена, никаких действий.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        }
      ]
    },
    "DETAILED": {
      "startNodeId": "d1",
      "nodes": [
        {
          "id": "d1",
          "type": "QUESTION",
          "text": "Повторное срабатывание не продолжается и новые попытки включения не планируются?",
          "responses": {
            "YES": "d2",
            "NO": "stop-safety",
            "UNKNOWN": "stop-safety"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "d2",
          "type": "QUESTION",
          "text": "В сохранённом журнале назван точный защитный аппарат, а не только фраза «выбило защиту»?",
          "responses": {
            "YES": "d3",
            "NO": "obs-a",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "d3",
          "type": "QUESTION",
          "text": "Событие по журналу связано с пуском дизеля?",
          "responses": {
            "YES": "obs-b",
            "NO": "d4",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "d4",
          "type": "QUESTION",
          "text": "Событие связано с ранее зафиксированным набором тяги или сборкой поездной схемы?",
          "responses": {
            "YES": "obs-c",
            "NO": "d5",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "d5",
          "type": "QUESTION",
          "text": "В штатной истории есть отдельное указание на зарядную или вспомогательную цепь?",
          "responses": {
            "YES": "obs-d",
            "NO": "obs-e",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "obs-a",
          "type": "OBSERVATION_REPORT",
          "text": "Без идентификации аппарата нельзя выбирать защищаемую ветвь, номинал или процедуру восстановления.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "obs-b",
          "type": "OBSERVATION_REPORT",
          "text": "Связь с пуском не доказывает дефект тягового генератора; сценарий CHME3-DIAG-106 и пусковые цепи рассматриваются отдельно.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "obs-c",
          "type": "OBSERVATION_REPORT",
          "text": "Связь с тяговой схемой не равна доказанному пробою изоляции: реле боксования, заземления и иные защиты имеют разные назначения.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "obs-d",
          "type": "OBSERVATION_REPORT",
          "text": "Вспомогательные цепи и зарядка рассматриваются отдельно от силовой защиты; CHME3-DIAG-107/108 не подменяют точную идентификацию аппарата.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "obs-e",
          "type": "OBSERVATION_REPORT",
          "text": "При неизвестной причине и отсутствии совпадающего режима источник защиты не установлен; обход и повторные включения запрещены.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "stop-safety",
          "type": "STOP",
          "text": "STOP: безопасность не подтверждена. Не возобновлять нагрузку, не повторять включения, не вскрывать аппараты, не обходить защиты.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "stop-unknown",
          "type": "STOP",
          "text": "STOP: источник, профиль или прежние наблюдения неизвестны; причина не установлена, никаких действий.",
          "responses": {},
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        }
      ]
    }
  },
