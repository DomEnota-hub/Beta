            "YES": "obs-b",
            "NO": "obs-c",
            "UNKNOWN": "stop-unknown"
          },
          "sourceRefs": [
            "DOC"
          ],
          "permittedAction": false
        },
        {
          "id": "obs-a",
          "type": "OBSERVATION_REPORT",
          "text": "Архив не подтверждает сохранение пусковой цепи после запуска. Не смешивать с зависанием до проворота.",
