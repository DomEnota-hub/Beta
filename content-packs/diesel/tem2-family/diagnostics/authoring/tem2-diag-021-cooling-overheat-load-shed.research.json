          "sourceRefs": [
            "DOC",
            "ARCHIVE",
            "FACTORY_U"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "stop-safety",
          "type": "STOP",
          "text": "STOP / SAFETY: при текущем событии, опасности или необходимости новой проверки опрос прекращён. Не выполнять включений, измерений, нагрузочных проб, обходов защит и вмешательств.",
          "responses": {},
          "sourceRefs": [
            "DOC",
            "CURRENT_GAP"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        },
        {
          "id": "stop-unknown",
          "type": "STOP",
          "text": "STOP: архивных сведений недостаточно. Не получать их повторным запуском, переключениями, движением, разборкой, измерениями или перемычками.",
          "responses": {},
          "sourceRefs": [
            "DOC",
            "CURRENT_GAP"
          ],
          "permittedAction": false,
          "causeConfirmed": false
        }
      ]
