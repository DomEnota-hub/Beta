        },
        {
          "id": "obs-a",
          "type": "OBSERVATION_REPORT",
          "text": "Перегрев или защитный сброс по архивным показаниям не подтверждён; отсутствие записи не равно исправности.",
          "responses": {},
          "sourceRefs": [
            "DOC",
            "ARCHIVE",
            "FACTORY_U"
          ],
          "permittedAction": false,
          "causeConfirmed": false
