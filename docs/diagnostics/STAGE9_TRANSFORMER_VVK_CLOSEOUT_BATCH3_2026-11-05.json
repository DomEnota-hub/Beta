      "informationExtensions": [
        {
          "id": "vvk-interlock-fault-extension-1",
          "version": "SHORT",
          "kind": "HISTORICAL_INFORMATION_ONLY",
          "approachFocus": "Состояние штор и разрешение на токоприёмник",
          "sourceRefs": [
            "manual1990"
          ],
          "locator": "Раздел А, цепи управления, печ. стр. 215–216: ПБ1/ПБ2, контроль 232/235 и зависимость разрешения от секций",
          "text": "Заводское историческое описание связывает закрытие штор ВВК с пневматическими блокировками и цепями управления. Отсутствие разрешения не доказывает неисправность отдельного аппарата.",
          "warningRequired": true,
          "actionAuthorityGranted": false
        },
        {
          "id": "vvk-interlock-fault-extension-2",
          "version": "SHORT",
          "kind": "EDUCATIONAL_INFORMATION_ONLY",
          "approachFocus": "Пневматическая и электрическая границы",
          "sourceRefs": [
            "textbook2006"
          ],
          "locator": "Глава 7, печ. стр. 266–269: пневматические блокировки ПБ1/ПБ2 и вентиль защиты ВЗ-57-02",
          "text": "Учебное описание разделяет механическое закрытие, пневматическое блокирование и электрический сигнал. Их противоречие требует STOP, а не попытки обхода блокировки.",
          "warningRequired": true,
          "actionAuthorityGranted": false
        },
        {
          "id": "vvk-interlock-fault-extension-3",
          "version": "DETAILED",
          "kind": "HISTORICAL_INFORMATION_ONLY",
          "approachFocus": "БУ-01-02 как вариант, не универсальный аппарат",
          "sourceRefs": [
            "manual1990"
          ],
          "locator": "Раздел А, аппараты, печ. стр. 90–91: блокировочное устройство БУ-01-02 и взаимное блокирование штор и токоприёмника",
          "text": "Устройство БУ-01-02 описано для определённого исторического исполнения. Наличие или отсутствие этого аппарата на конкретной секции должно подтверждаться документацией.",
          "warningRequired": true,
          "actionAuthorityGranted": false
        },
        {
          "id": "vvk-interlock-fault-extension-4",
          "version": "DETAILED",
          "kind": "EDUCATIONAL_INFORMATION_ONLY",
          "approachFocus": "Ключевая блокировка и ложная индикация",
          "sourceRefs": [
            "textbook2006"
          ],
          "locator": "Глава 7 §7.10, печ. стр. 275–276: БУ-01-02, ключевая блокировка и условие закрытия ВВК",
          "text": "Учебный материал различает положение ключей и состояние блокировочного устройства. По индикации без подтверждения исполнения нельзя делать вывод о безопасном доступе в ВВК.",
          "warningRequired": true,
          "actionAuthorityGranted": false
        },
        {
          "id": "vvk-interlock-fault-extension-5",
          "version": "DETAILED",
          "kind": "EDUCATIONAL_INFORMATION_ONLY",
          "approachFocus": "Не смешивать ПБ1/ПБ2 с отдельным реле",
          "sourceRefs": [
            "textbook2006"
          ],
          "locator": "Глава 7, печ. стр. 266–269: пневматические блокировки ПБ1/ПБ2 и вентиль защиты ВЗ-57-02",
          "text": "Пневматические блокировки и реле контроля относятся к связанным, но различным элементам защиты. Номер аппарата из исторической схемы не является доказательством установленной комплектации.",
          "warningRequired": true,
          "actionAuthorityGranted": false
        }
